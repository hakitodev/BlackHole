DISCORD_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
OWNER_ID=
PORT=3000

# На Render можно не ставить. Нужен только если хочешь свой домен.
# PUBLIC_URL=https://имя.onrender.com

# В Discord Developer Portal → OAuth2 → Redirects:
# https://имя.onrender.com/oauth/callback
# (не dashboard.render.com — это админка Render, не сайт бота)

# Необязательно. Префикс текстовых команд, по умолчанию !
# PREFIX=!

# Файл экономики. На хостинге укажи путь на persistent disk, иначе деплой обнулит балансы.
# DATABASE_PATH=/data/economy.sqlite

