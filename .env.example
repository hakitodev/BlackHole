DISCORD_TOKEN=
CLIENT_ID=
OWNER_ID=
PORT=3000

# Необязательно. Префикс текстовых команд, по умолчанию !
# PREFIX=!

# Файл экономики. На хостинге укажи путь на persistent disk, иначе деплой обнулит балансы.
# DATABASE_PATH=/data/economy.sqlite

# Необязательно. По умолчанию ./servers.json
# SERVERS_FILE=./servers.json

# Вместо файла можно отдать JSON строкой:
# SERVERS_JSON={"123456789012345678":{"channelId":"123456789012345678","welcomeMessage":"Привет, {user}","leaveMessage":"Прощай, {user}"}}
